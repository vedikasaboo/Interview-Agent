generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum CandidateStatus {
  INVITED
  SCHEDULED
  INTERVIEWED
  PASSED
  REJECTED
}

enum ParseStatus {
  PENDING
  SUCCESS
  FAILED
}

model Recruiter {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  passwordHash String     @map("password_hash")
  name         String
  company      String
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  campaigns    Campaign[]

  @@map("recruiter")
}

model Campaign {
  id          Int             @id @default(autoincrement())
  title       String
  role        String
  description String?         @db.Text
  recruiterId Int             @map("recruiter_id")
  recruiter   Recruiter       @relation(fields: [recruiterId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  candidates  Candidate[]
  slots       InterviewSlot[]

  @@map("campaign")
}

model Candidate {
  id              Int              @id @default(autoincrement())
  name            String
  email           String
  interviewToken  String           @unique @map("interview_token")
  status          CandidateStatus  @default(INVITED)
  appliedAt       DateTime         @default(now()) @map("applied_at")
  interviewedAt   DateTime?        @map("interviewed_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  campaignId      Int              @map("campaign_id")
  campaign        Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  resume          Resume?
  interviewResult InterviewResult?
  booking         Booking?
  skills          CandidateSkill[]

  @@unique([campaignId, email])
  @@map("candidate")
}

model Resume {
  id          Int         @id @default(autoincrement())
  candidateId Int         @unique @map("candidate_id")
  candidate   Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  rawFilePath String      @map("raw_file_path")
  parsedData  Json?       @map("parsed_data")
  parseStatus ParseStatus @default(PENDING) @map("parse_status")
  parseError  String?     @db.Text @map("parse_error") // failure reason when parseStatus = FAILED
  parsedAt    DateTime?   @map("parsed_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("resume")
}

model Skill {
  id         Int              @id @default(autoincrement())
  name       String           @unique
  candidates CandidateSkill[]

  @@map("skill")
}

model CandidateSkill {
  candidateId Int       @map("candidate_id")
  skillId     Int       @map("skill_id")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([candidateId, skillId])
  @@index([skillId, candidateId])
  @@map("candidate_skill")
}

model InterviewSlot {
  id         Int       @id @default(autoincrement())
  campaignId Int       @map("campaign_id")
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  startsAt   DateTime  @map("starts_at")
  capacity   Int       @default(1)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  bookings   Booking[]

  @@map("interview_slot")
}

model Booking {
  id          Int           @id @default(autoincrement())
  slotId      Int           @map("slot_id")
  candidateId Int           @unique @map("candidate_id")
  slot        InterviewSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  candidate   Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now()) @map("created_at")

  @@unique([slotId, candidateId])
  @@map("booking")
}

model InterviewResult {
  id          Int       @id @default(autoincrement())
  candidateId Int       @unique @map("candidate_id")
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  transcript  String    @db.LongText
  summary     String    @db.Text
  score       Int
  strengths   Json?
  concerns    Json?
  // Where the conversation supported or failed to support résumé claims. Kept
  // separate from `concerns` so it can't be confused with general interview
  // weaknesses, and so the recruiter UI can surface it distinctly.
  discrepancies Json?   @map("discrepancies")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([score])
  @@map("interview_result")
}

model AuditLog {
  id             Int      @id @default(autoincrement())
  candidateId    Int      @map("candidate_id")
  candidateEmail String   @map("candidate_email")
  oldStatus      String   @map("old_status")
  newStatus      String   @map("new_status")
  changedAt      DateTime @default(now()) @map("changed_at")

  @@map("audit_log")
}
